cmd_to_issues() {
  ensure_instructions
  require_backend
  local task_name="${1:-}"
  if [[ -z "$task_name" ]]; then
    echo "usage: paw to-issues <task-name> [--publish]" >&2
    exit 2
  fi
  shift

  local publish=0
  local -a extras_args=()
  local arg
  for arg in "$@"; do
    case "$arg" in
      --publish) publish=1 ;;
      *) extras_args+=("$arg") ;;
    esac
  done

  if [[ "${#extras_args[@]}" -gt 0 ]]; then
    _task_assignment_resume_or_handoff to-issues "$task_name" "${extras_args[@]}"
  else
    _task_assignment_resume_or_handoff to-issues "$task_name"
  fi
  _require_task_dir "$task_name"
  local task_dir="$PWD/.agent/$task_name"
  _to_issues_seed_docs "$task_dir"

  if [[ "$publish" -eq 1 ]]; then
    _to_issues_publish "$task_name" "$task_dir"
    return 0
  fi

  local extras prompt
  if [[ "${#extras_args[@]}" -gt 0 ]]; then
    extras=$(_join_prompt_extras "${extras_args[@]}")
  else
    extras=""
  fi
  prompt=$(cat <<'EOF'
Follow __INSTRUCTIONS__, with <!-- PAW:IMPLEMENT --> as the primary section for this run, and continue the approved task in .agent/__TASK__/ by drafting tracer-bullet issue slices under .agent/__TASK__/issues/. Do not create commits.__PR_NOTE__

This is a `paw to-issues` run. Convert the approved work into reviewable GitHub issue drafts before any publication step.

Required draft workflow:
- Read the approved task docs in .agent/__TASK__/ first and preserve the plan scope boundaries.
- Keep the upstream tracer-bullet behavior: prefer thin vertical slices, mark each slice as HITL or AFK, review dependencies explicitly, and quiz the user on granularity, dependencies, merges/splits, and HITL/AFK labels before publication.
- Write or refresh .agent/__TASK__/issues/index.md with the numbered proposed breakdown plus the review quiz and any parent-task context needed for publication.
- Write one draft file per slice under .agent/__TASK__/issues/*.md using this exact metadata section:
  ## Draft Metadata
  - Slug: <unique-kebab-case>
  - Type: HITL|AFK
  - Blocked by: <comma-separated slugs or None - can start immediately>
  - Status: draft
  - Issue Number:
  - Issue URL:
- After the metadata, keep the issue body reviewable and reusable with sections for:
  ## Parent
  ## What to build
  ## Acceptance criteria
  ## Blocked by
- Do not publish issues in this run. Publishing is a separate explicit shell step: `paw to-issues __TASK__ --publish`.
EOF
)
  prompt=${prompt//__INSTRUCTIONS__/$INSTRUCTIONS}
  prompt=${prompt//__TASK__/$task_name}
  prompt=${prompt//__PR_NOTE__/$(_prompt_pr_md_usage_note "$task_dir")}

  prompt=$(_prompt_append_human_extras "$prompt" "$extras")
  _run_model_subcommand to-issues "$task_dir" "implement" "$prompt"
}

cmd_pr_submit() {
  require_gh
  local task_name="${1:-}"
  if [[ -z "$task_name" ]]; then
    echo "usage: paw pr-submit <task-name>" >&2
    exit 2
  fi
  shift
  if [[ $# -gt 0 ]]; then
    echo "error: paw pr-submit accepts only <task-name>" >&2
    exit 2
  fi

  _task_assignment_resume_or_handoff pr-submit "$task_name"
  _require_task_dir "$task_name"

  local task_dir="$PWD/.agent/$task_name"
  local pr_file="$task_dir/pr.md"
  if [[ ! -f "$pr_file" ]]; then
    echo "error: $pr_file is required for 'paw pr-submit'." >&2
    exit 1
  fi

  local pr_title pr_url pr_number
  pr_title=$(_task_doc_title "$task_dir" "$task_name")
  pr_url=$(gh pr create --draft --title "$pr_title" --body-file "$pr_file")
  pr_url=$(printf '%s\n' "$pr_url" | grep -Eo 'https://[^[:space:]]+/pull/[0-9]+' | tail -n1)
  if [[ -z "$pr_url" ]]; then
    echo "error: gh pr create did not return a PR URL." >&2
    exit 1
  fi
  pr_number=$(printf '%s\n' "$pr_url" | sed -E 's#.*/pull/([0-9]+)$#\1#')
  _task_pr_tracking_upsert "$task_dir" "$pr_number" "$pr_url"
  printf 'created draft PR #%s: %s\n' "$pr_number" "$pr_url"
}

cmd_issue_submit() {
  require_gh
  local task_name="${1:-}"
  if [[ -z "$task_name" ]]; then
    echo "usage: paw issue-submit <task-name>" >&2
    exit 2
  fi
  shift
  if [[ $# -gt 0 ]]; then
    echo "error: paw issue-submit accepts only <task-name>" >&2
    exit 2
  fi

  _task_assignment_resume_or_handoff issue-submit "$task_name"
  _require_task_dir "$task_name"

  local task_dir="$PWD/.agent/$task_name"
  local issue_file="$task_dir/issue.md"
  if [[ ! -f "$issue_file" ]]; then
    echo "error: $issue_file is required for 'paw issue-submit'." >&2
    exit 1
  fi

  local issue_title issue_url issue_number
  issue_title=$(_task_doc_title "$task_dir" "$task_name")
  issue_url=$(_gh_issue_create_from_file "$issue_title" "$issue_file")
  issue_number=$(_gh_issue_number_from_url "$issue_url")
  _task_issue_tracking_upsert "$task_dir" "$issue_number" "$issue_url"
  printf 'created issue #%s: %s\n' "$issue_number" "$issue_url"
}

cmd_pr_review() {
  local pr_number="${1:-}"
  if [[ -z "$pr_number" ]]; then
    echo "usage: paw pr-review <pr-number>" >&2
    exit 2
  fi
  if [[ -n "${2:-}" ]]; then
    echo "error: paw pr-review accepts only <pr-number>" >&2
    exit 2
  fi

  local task_name=""
  task_name=$(_task_find_by_pr_number "$pr_number") || exit 1
  _task_assignment_resume_or_handoff pr-review "$task_name"
  local task_dir="$PWD/.agent/$task_name"
  local review_file="$task_dir/review.md"

  if [[ ! -f "$review_file" ]]; then
    local comments_output
    comments_output=$("${PAW_GH_COMMENTS_CMD:-$SCRIPT_DIR/gh-pr-comments.sh}" "$pr_number" 2>/dev/null) || true
    if [[ -z "$comments_output" ]]; then
      comments_output="# No unresolved PR comments"
    fi
    _review_draft_write "$review_file" "$task_name" "$pr_number" "collected" "$comments_output"
    printf 'collected review draft: %s\n' "$review_file"
    return 0
  fi

  local review_status tmp_body
  review_status=$(_review_status "$review_file" || true)
  if [[ "$review_status" == "submitted" ]]; then
    printf 'review draft already submitted: %s\n' "$review_file"
    return 0
  fi

  require_gh
  tmp_body=$(mktemp)
  _review_submission_body "$review_file" > "$tmp_body"
  gh pr review "$pr_number" --comment --body-file "$tmp_body"
  rm -f "$tmp_body"
  _review_mark_submitted "$review_file" "$pr_number"
  printf 'submitted review draft for PR #%s\n' "$pr_number"
}

cmd_pr_address_comments() {
  ensure_instructions
  require_backend
  local pr_number="${1:-}"
  if [[ -z "$pr_number" ]]; then
    echo "usage: paw pr-address-comments <pr-number>  (requires gh and jq on PATH)" >&2
    exit 2
  fi
  if [[ -n "${2:-}" ]]; then
    echo "error: paw pr-address-comments signature changed; use: paw pr-address-comments <pr-number>" >&2
    exit 2
  fi
  local task_name="${pr_number}-review"
  local task_dir="$PWD/.agent/$task_name"
  _seed_task_templates "$task_dir" contract plan

  # Fetch PR comments; write to comments.md (or placeholder when empty/unavailable).
  local comments_file="$task_dir/comments.md"
  local comments_output
  comments_output=$("${PAW_GH_COMMENTS_CMD:-$SCRIPT_DIR/gh-pr-comments.sh}" "$pr_number" 2>/dev/null) || true
  if [[ -z "$comments_output" ]]; then
    printf '# No unresolved PR comments\n' > "$comments_file"
  else
    printf '%s\n' "$comments_output" > "$comments_file"
  fi

  # Discover prior tasks (filter out this review task).
  local prior_tasks="" _d _dname
  for _d in "$PWD/.agent"/*/; do
    [[ -d "$_d" ]] || continue
    _dname="${_d%/}"; _dname="${_dname##*/}"
    [[ "$_dname" == "$task_name" ]] && continue
    prior_tasks+="$_dname "
  done
  prior_tasks="${prior_tasks% }"

  local branch
  branch=$(git -C "$PWD" branch --show-current 2>/dev/null || echo "unknown")

  local seeded_list
seeded_list="- .agent/$task_name/contract.md
- .agent/$task_name/plan.md"

  local prior_block=""
  if [[ -n "$prior_tasks" ]]; then
    prior_block="
Prior tasks found in .agent/: $prior_tasks"
  fi

  local prompt
  prompt=$(cat <<EOF
Follow $INSTRUCTIONS, with <!-- PAW:PLAN --> as the primary section for this run, and create a new plan-only task package in .agent/$task_name/.

This is a PR review planning pass for branch '$branch'. PR number: $pr_number.
$prior_block
Read .agent/$task_name/comments.md — it contains the fetched PR review feedback (INLINE / REVIEW SUMMARY / PR COMMENT). For each comment item, plan to either address, defer (with reason), or decline (with reason).

The template files have already been seeded under .agent/$task_name/. Fill them in:
$seeded_list
pr.md is not used for this task (no PR template in repo). Do not create commits.
EOF
)

  _run_model_subcommand pr-address-comments "$task_dir" "plan" "$prompt"
}

cmd_issue_review() {
  ensure_instructions
  require_backend
  local issue_number="${1:-}"
  if [[ -z "$issue_number" ]]; then
    echo "usage: paw issue-review <issue-number>" >&2
    exit 2
  fi
  if [[ -n "${2:-}" ]]; then
    echo "error: paw issue-review accepts only <issue-number>" >&2
    exit 2
  fi

  local task_name="${issue_number}-issue-review"
  local task_dir="$PWD/.agent/$task_name"
  _seed_task_templates "$task_dir" contract plan

  local issue_file="$task_dir/issue.md"
  local fetched_issue
  fetched_issue=$(_gh_issue_fetch_body "$issue_number" 2>/dev/null) || true
  if [[ -z "$fetched_issue" ]]; then
    fetched_issue=$(cat <<EOF
Title: Issue #$issue_number
URL: unknown

# No issue body fetched
EOF
)
  fi
  _issue_review_doc_write "$issue_file" "$task_name" "$issue_number" "$fetched_issue"
  _task_assignment_record "$task_name"

  local seeded_list
seeded_list="- .agent/$task_name/contract.md
- .agent/$task_name/plan.md
- .agent/$task_name/issue.md"

  local prompt
  prompt=$(cat <<EOF
Follow $INSTRUCTIONS, with <!-- PAW:PLAN --> as the primary section for this run, and create or refine the plan-only task package in .agent/$task_name/.

This is an issue-review planning pass. Issue number: $issue_number.
Read .agent/$task_name/issue.md — it contains the fetched GitHub issue title, metadata, and body. Plan from the issue body only; do not treat issue comments as in scope unless the task package explicitly expands scope later.

The template files have already been seeded under .agent/$task_name/. Fill them in:
$seeded_list
pr.md is not used for this task (no PR template in repo). Do not create commits.
EOF
)

  _run_model_subcommand issue-review "$task_dir" "plan" "$prompt"
}

