  "$helper" "$@"
}

cmd_review() {
  if [[ -z "${1:-}" ]]; then
    echo "error: paw review has been replaced by paw pr-address-comments <pr-number>." >&2
    exit 2
  fi
  echo "error: paw review has been replaced by paw pr-address-comments $1." >&2
  exit 2
}

cmd_compact() {
  local task_name="${1:-}"
  if [[ -z "$task_name" ]]; then
    echo "usage: paw compact <task-name>" >&2
    exit 2
  fi
  local task_dir="$PWD/.agent/$task_name"
  if [[ ! -d "$task_dir" ]]; then
    echo "error: task directory not found: $task_dir" >&2
    exit 2
  fi

  local plan="$task_dir/plan.md"
  local moved_phases=0

  # --- Archive ticked - [x] phase items from plan.md ---
  if [[ -f "$plan" ]]; then
    local tmp
    tmp=$(mktemp)
    # Collect ticked items plus their immediate Progress line from the
    # Implementation Phases section.
    local ticked_items
    ticked_items=$(awk '
      /^## Implementation Phases/ { in_phases=1; next }
      in_phases && /^## / { in_phases=0 }
      in_phases && /^- \[x\]/ {
        print
        capture_progress = 1
        next
      }
      capture_progress && /^[[:space:]]+Progress:/ {
        print
        capture_progress = 0
        next
      }
      capture_progress { capture_progress = 0 }
    ' "$plan")

    if [[ -n "$ticked_items" ]]; then
      local count
      count=$(echo "$ticked_items" | wc -l | tr -d ' ')
      # Remove ticked items from the phases section; append to ### Archived Phases.
      awk '
        /^## Implementation Phases/ { in_phases=1; print; next }
        in_phases && /^## / { in_phases=0 }
        in_phases && /^- \[x\]/ { skip_progress = 1; next }
        skip_progress && /^[[:space:]]+Progress:/ { skip_progress = 0; next }
        skip_progress { skip_progress = 0 }
        { print }
      ' "$plan" > "$tmp"

      # Append ### Archived Phases if not already present.
      if ! grep -q '^### Archived Phases' "$tmp"; then
        printf '\n### Archived Phases\n' >> "$tmp"
      fi
      echo "$ticked_items" >> "$tmp"
      mv "$tmp" "$plan"
      moved_phases=$count
    fi
  fi

  if [[ $moved_phases -eq 0 ]]; then
    echo "compact: nothing to archive in $task_name" >&2
  else
    echo "compact: archived $moved_phases completed phase(s) → ### Archived Phases in plan.md" >&2
  fi
  return 0
}

cmd_crash_log() {
  local task_name="${1:-}"
  if [[ -z "$task_name" ]]; then
    echo "usage: paw crash-log <task-name>" >&2
    exit 2
  fi
  local task_dir="$PWD/.agent/$task_name"
  if [[ ! -d "$task_dir" ]]; then
    echo "error: task directory not found: $task_dir" >&2
    exit 2
  fi
  crash_log_show "$task_dir"
}

cmd_model() {
  local verbose=0
  local arg
  for arg in "$@"; do
    case "$arg" in
      --verbose|-v) verbose=1 ;;
    esac
  done
  local sub _unused
  while IFS='|' read -r sub _unused; do
    printf '%-10s %s\n' "${sub}:" "$(_backend_model "$(_resolve_model "$sub")")"
  done < <(_paw_model_command_table)
  if [[ $verbose -eq 1 ]]; then
    printf 'backend:   %s\n' "$PAW_BACKEND"
    printf 'stream:    %s\n' "$PAW_STREAM"
    printf 'max-turns: %s\n' "$PAW_MAX_TURNS"
  fi
}

cmd_list() {
  "$SCRIPT_DIR/list-tasks.sh" "$@"
}

cmd_lint() {
  "$SCRIPT_DIR/lint-task.sh" "$@"
}

cmd_setup() {
  "$SCRIPT_DIR/setup-repo.sh" "$@"
}

dispatch_subcommand() {
  local sub="$1"
  shift

  local name handler args desc
  while IFS=$'\x1f' read -r name handler args desc; do
    [[ "$sub" == "$name" ]] || continue
    "$handler" "$@"
    return $?
  done < <(_paw_command_table)

  return 255
}

main() {
  local sub="${1:-help}"
  if [[ $# -gt 0 ]]; then shift; fi
  case "$sub" in
    -h|--help)
      usage
      return 0
      ;;
    review)
      cmd_review "$@"
      ;;
  esac

  local status=0
  if dispatch_subcommand "$sub" "$@"; then
    return 0
  else
    status=$?
  fi
  if [[ $status -eq 255 ]]; then
    echo "unknown subcommand: $sub" >&2
    usage >&2
    exit 2
  fi

  return $status
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
